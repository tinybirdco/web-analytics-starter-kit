{
  "name": "@tinybirdco/web-analytics-starter-kit",
  "private": true,
  "description": "Web Analytics Starter Kit - A privacy-first analytics solution built with Tinybird",
  "scripts": {
    "dev": "pnpm --filter @tinybirdco/analytics-dashboard dev",
    "build": "pnpm --filter @tinybirdco/analytics-dashboard build",
    "lint": "pnpm --filter @tinybirdco/analytics-dashboard lint",
    "client:dev": "pnpm --filter @tinybirdco/analytics-client dev",
    "client:build": "pnpm --filter @tinybirdco/analytics-client build",
    "client:deploy": "pnpm --filter @tinybirdco/analytics-client deploy"
  },
  "engines": {
    "node": ">=22"
  }
}
